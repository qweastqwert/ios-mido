			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			enable-method = "psci";
			reg = <0x103>;
			capacity-dmips-mhz = <0x466>;
			sched-energy-costs = <0x0a>;
