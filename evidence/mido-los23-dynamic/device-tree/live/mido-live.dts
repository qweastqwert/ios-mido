			enable-method = "psci";
			reg = <0x100>;
			capacity-dmips-mhz = <0x466>;
			sched-energy-costs = <0x0a>;
			next-level-cache = <0x0c>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;

			l2-cache {
				compatible = "arm,arch-cache";
