		pinctrl@1000000 {
			compatible = "qcom,msm8953-pinctrl";
			reg = <0x1000000 0x300000>;
			reg-names = "pinctrl_regs";
			interrupts-extended = <0x01 0x00 0xd0 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			wakeup-parent = <0x4d>;
			#interrupt-cells = <0x02>;
			irqdomain-map = <0x26 0x00 0x4d 0x03 0x00 0x01 0x00 0x4d 0x04 0x00 0x05 0x00 0x4d 0x05 0x00 0x09 0x00 0x4d 0x06 0x00 0x25 0x00 0x4d 0x08 0x00 0x24 0x00 0x4d 0x09 0x00 0x0d 0x00 0x4d 0x0a 0x00 0x23 0x00 0x4d 0x0b 0x00 0x11 0x00 0x4d 0x0c 0x00 0x15 0x00 0x4d 0x0d 0x00 0x36 0x00 0x4d 0x0e 0x00 0x22 0x00 0x4d 0x0f 0x00 0x1f 0x00 0x4d 0x10 0x00 0x3a 0x00 0x4d 0x11 0x00 0x1c 0x00 0x4d 0x12 0x00 0x2a 0x00 0x4d 0x13 0x00 0x19 0x00 0x4d 0x14 0x00 0x0c 0x00 0x4d 0x15 0x00 0x2b 0x00 0x4d 0x16 0x00 0x2c 0x00 0x4d 0x17 0x00 0x2d 0x00 0x4d 0x18 0x00 0x2e 0x00 0x4d 0x19 0x00 0x30 0x00 0x4d 0x1a 0x00 0x41 0x00 0x4d 0x1b 0x00 0x5d 0x00 0x4d 0x1c 0x00 0x61 0x00 0x4d 0x1d 0x00 0x3f 0x00 0x4d 0x1e 0x00 0x46 0x00 0x4d 0x1f 0x00 0x47 0x00 0x4d 0x20 0x00 0x48 0x00 0x4d 0x21 0x00 0x51 0x00 0x4d 0x22 0x00 0x55 0x00 0x4d 0x23 0x00 0x5a 0x00 0x4d 0x24 0x00 0x43 0x00 0x4d 0x32 0x00 0x49 0x00 0x4d 0x33 0x00 0x4a 0x00 0x4d 0x34 0x00 0x3e 0x00 0x4d 0x35 0x00 0x3b 0x00 0x4d 0x3b 0x00 0x3c 0x00 0x4d 0x3c 0x00 0x3d 0x00 0x4d 0x3d 0x00 0x56 0x00 0x4d 0x3e 0x00 0x57 0x00 0x4d 0x3f 0x00 0x5b 0x00 0x4d 0x40 0x00 0x81 0x00 0x4d 0x41 0x00 0x82 0x00 0x4d 0x42 0x00 0x83 0x00 0x4d 0x43 0x00 0x84 0x00 0x4d 0x44 0x00 0x85 0x00 0x4d 0x45 0x00 0x89 0x00 0x4d 0x46 0x00 0x8a 0x00 0x4d 0x47 0x00 0x8b 0x00 0x4d 0x48 0x00 0x8c 0x00 0x4d 0x49 0x00 0x8d 0x00 0x4d 0x4a 0x00>;
			irqdomain-map-pass-thru = <0x00 0xff>;
			irqdomain-map-mask = <0xff 0x00>;
			phandle = <0x7a>;

			pmx-uartconsole {

				uart_console_active {
					phandle = <0xba>;

					mux {
						pins = "gpio4\0gpio5";
						function = "blsp_uart2";
					};

					config {
						pins = "gpio4\0gpio5";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				uart_console_sleep {

					mux {
						pins = "gpio4\0gpio5";
						function = "blsp_uart2";
					};

					config {
						pins = "gpio4\0gpio5";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				uart1_console_active {

					mux {
						pins = "gpio20\0gpio21";
						function = "blsp_uart6";
					};

					config {
						pins = "gpio20\0gpio21";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				uart1_console_sleep {

					mux {
						pins = "gpio20\0gpio21";
						function = "blsp_uart6";
					};

					config {
						pins = "gpio20\0gpio21";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			cci {

				cci0_active {
					phandle = <0x134>;

					mux {
						pins = "gpio29\0gpio30";
						function = "cci_i2c";
					};

					config {
						pins = "gpio29\0gpio30";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				cci0_suspend {
					phandle = <0x136>;

					mux {
						pins = "gpio29\0gpio30";
						function = "cci_i2c";
					};

					config {
						pins = "gpio29\0gpio30";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				cci1_active {
					phandle = <0x135>;

					mux {
						pins = "gpio31\0gpio32";
						function = "cci_i2c";
					};

					config {
						pins = "gpio31\0gpio32";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				cci1_suspend {
					phandle = <0x137>;

					mux {
						pins = "gpio31\0gpio32";
						function = "cci_i2c";
					};

					config {
						pins = "gpio31\0gpio32";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			cam_sensor_mclk0_default {
				phandle = <0x139>;

				mux {
					pins = "gpio26";
					function = "cam_mclk";
				};

				config {
					pins = "gpio26";
