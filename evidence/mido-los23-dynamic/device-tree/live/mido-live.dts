/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. MSM8953 + PMI8950 QRD SKU3";
	compatible = "qcom,msm8953-qrd-sku3\0qcom,msm8953-qrd\0qcom,msm8953\0qcom,qrd\0xiaomi,mido";
	qcom,msm-id = <0x125 0x00>;
	qcom,msm-name = "MSM8953";
	interrupt-parent = <0x01>;
	qcom,enable-legacy-adsp-hacks;
	qcom,board-id = <0x0b 0x00>;

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x0a>;
			next-level-cache = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x02>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x0b>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			enable-method = "psci";
			reg = <0x01>;
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x0a>;
			next-level-cache = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x03>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			enable-method = "psci";
			reg = <0x02>;
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x0a>;
			next-level-cache = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x04>;

			l1-icache {
				compatible = "arm,arch-cache";
			};

			l1-dcache {
				compatible = "arm,arch-cache";
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			enable-method = "psci";
			reg = <0x03>;
			capacity-dmips-mhz = <0x400>;
			sched-energy-costs = <0x0a>;
			next-level-cache = <0x0b>;
			#cooling-cells = <0x02>;
