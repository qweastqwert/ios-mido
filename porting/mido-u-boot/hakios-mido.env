/* HakiOS's U-Boot on Xiaomi Redmi Note 4 / 4X (mido). */
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

fastboot=fastboot -l $fastboot_addr_r usb 0

/* First bring-up is RAM-only; do not probe eMMC before USB is available. */
preboot=echo HakiOS mido RAM bring-up

bootcmd=if hakios load; then run hakios_start; fi; run hakios_fastboot
hakios_start=hakios boot
hakios_fastboot=echo; echo "HakiOS: waiting for the host:"; \
	echo "  fastboot stage x.hkub"; \
	echo "  fastboot oem run:hakios load fastboot"; \
	echo "  fastboot continue"; \
	setenv bootretry -1; run fastboot; hakios boot; pause; run menucmd

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=HakiOS (from memory)=hakios load; hakios boot; pause
bootmenu_1=HakiOS over fastboot=run hakios_fastboot
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Enable fastboot mode=run fastboot
bootmenu_4=What is in memory=hakios info; pause
bootmenu_5=Drop to shell=setenv bootretry -1
bootmenu_6=Reset device=reset
bootmenu_7=Board info=bdinfo; meminfo; pause

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
